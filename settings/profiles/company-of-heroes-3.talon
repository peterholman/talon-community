app.name: Anvil
mode: user.game
-

deck(pedal_middle): tracking.control_toggle()
deck(pedal_left:repeat): user.mouse_scroll_down(0.05)
deck(pedal_right:repeat): user.mouse_scroll_up(0.05)

move: mouse_click(1)
face: mouse_drag(1)
stop: key(space)
alpha: key(1)
bravo: key(2)
charlie: key(3)
delta: key(4)